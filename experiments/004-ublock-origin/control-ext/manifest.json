{
  "manifest_version": 2,
  "name": "Background control",
  "version": "1.0",
  "permissions": ["storage", "webRequest", "webRequestBlocking", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "browser_specific_settings": { "gecko": { "id": "bg-control@example.invalid" } }
}
